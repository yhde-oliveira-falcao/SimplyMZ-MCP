{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimplyMZ synthetic fixture ground truth",
  "type": "object",
  "required": ["generator_version", "name", "seed", "polarity", "n_ms1", "n_ms2",
               "rt_range_min", "scan_interval_min", "faults", "dropout_ms1_indices",
               "compounds", "content_digest", "file", "sha256"],
  "properties": {
    "polarity": {"enum": ["positive", "negative"]},
    "n_ms1": {"type": "integer", "minimum": 1},
    "n_ms2": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "formula", "adduct", "role", "ion_mz", "rt_min", "fwhm_min",
                     "sigma_min", "height_counts", "area_counts_min", "isotopes"],
        "properties": {
          "role": {"enum": ["planted", "contaminant", "carryover"]},
          "ion_mz": {"type": "number", "exclusiveMinimum": 0},
          "height_counts": {"type": "number", "exclusiveMinimum": 0},
          "isotopes": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["mz", "rel"]}
          }
        }
      }
    }
  }
}
